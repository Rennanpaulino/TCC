<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="#E3F2FD">

<com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
    android:id="@+id/fabReport"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Reportar Problema"
    android:textColor="#FFFFFF"
    android:backgroundTint="#F44336"
    app:icon="@android:drawable/stat_notify_error"
    app:iconTint="#FFFFFF"
    android:layout_alignParentBottom="true"
    android:layout_centerHorizontal="true"
    android:layout_marginBottom="24dp"/>

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_above="@id/fabReport"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtNomeEstacao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Carregando..."
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#0D47A1"
            android:textAlignment="center"
            android:layout_marginBottom="32dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Próximo trem em:"
            android:textSize="18sp"/>

        <TextView
            android:id="@+id/txtTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-- : --"
            android:textSize="64sp"
            android:textStyle="bold"
            android:textColor="#333333"/>

        <ProgressBar
            android:id="@+id/loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"/>

        <androidx.cardview.widget.CardView
            android:id="@+id/cardLotacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginHorizontal="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#E0E0E0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👥"
                    android:textSize="32sp"
                    android:layout_marginEnd="16dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtTituloLotacao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AGUARDANDO DADOS"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"/>

                    <TextView
                        android:id="@+id/txtQtdPessoas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- pessoas"
                        android:textSize="20sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/txtAviso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠️ Sinal GPS Estimado"
            android:gravity="center"
            android:background="#FFC107"
            android:padding="12dp"
            android:layout_marginTop="24dp"
            android:visibility="gone"
            android:textStyle="bold"
            android:textColor="#000000"/>

    </LinearLayout>
</ScrollView>

</RelativeLayout>